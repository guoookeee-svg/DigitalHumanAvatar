# ─── LLM 配置（OpenAI 模式 / vLLM）─────────────
# 填入你自己的 API Key 与本地模型端点
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=http://<你的vLLM主机>:8080/v1
LLM_MODEL=ds-v4-flash

# ─── QwenPaw Agent 配置（agent 模式可选用）─────────────
QWENPAW_HOST=https://<你的agent服务域名>
QWENPAW_PORT=30027
QWENPAW_AGENT=<agent_id>
QWENPAW_SESSION=<session_id>

# ─── GPU 绑定 ─────────────
# 只使用 GPU 0，避免用到被 vLLM 占用的 GPU 1-5
CUDA_VISIBLE_DEVICES=0

# ─── ModelScope 模型缓存目录 ─────────────
# 所有 funasr 模型（SenseVoice/fsmn-vad/CAM++/paraformer）统一缓存目录
MODELSCOPE_CACHE=./models/modelscope
