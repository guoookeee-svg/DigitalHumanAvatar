{
  "mode": "openai",
  "openai": {
    "base_url": "http://<你的vLLM主机>:8080/v1",
    "api_key": "sk-xxxxxxxxxxxxxxxxxxxxxxxx",
    "model": "ds-v4-flash",
    "embed_model": "bge-m3",
    "rerank_model": "bge-reranker-v2-m3"
  },
  "agent": {
    "host": "https://<你的agent服务域名>",
    "port": "30027",
    "path": "/api/console/chat",
    "agent_id": "<agent_id>",
    "session_id": "<session_id>",
    "response_type": "sse",
    "response_text_path": "text",
    "headers": {
      "X-Agent-Id": "{agent_id}",
      "Content-Type": "application/json"
    },
    "body_template": {
      "session_id": "{session_id}",
      "user_id": "<user_id>",
      "channel": "acp",
      "input": [
        {
          "content": [
            {
              "type": "text",
              "text": "{message}"
            }
          ]
        }
      ]
    }
  },
  "interaction_mode": "solo",
  "speaker": {
    "enabled": true,
    "match_threshold": 0.55,
    "session_threshold": 0.65,
    "self_filter_enabled": true,
    "self_filter_threshold": 0.55,
    "min_audio_ms": 600,
    "min_speakers_for_annotate": 2
  },
  "memory": {
    "min_score": 0.35,
    "max_entries": 1000,
    "decay_weight": 0.25,
    "decay_half_life_days": 30,
    "min_len_user": 6,
    "min_len_assistant": 6,
    "filter_greetings": true,
    "rerank_enabled": false,
    "cache_ttl": 30
  },
  "meeting": {
    "owner_name": "<owner_name>",
    "owner_speaker": "<owner_speaker>",
    "address_keywords": [],
    "question_patterns": [],
    "proactive_level": "off"
  }
}
